{
  "Cloudflare": {
    "headers": ["cf-ray", "cf-cache-status", "cf-request-id"],
    "body_patterns": ["Attention Required! | Cloudflare", "cloudflare-nginx", "Ray ID:"],
    "status_codes": [403, 503],
    "cookies": ["__cfduid", "cf_clearance"],
    "bypass_payloads": ["X-Originating-IP: 127.0.0.1", "X-Forwarded-For: 127.0.0.1", "X-Remote-IP: 127.0.0.1", "X-Client-IP: 127.0.0.1"]
  },
  "Akamai": {
    "headers": ["x-check-cacheable", "x-akamai-transformed", "akamai-origin-hop"],
    "body_patterns": ["Access Denied", "Reference #", "AkamaiGHost"],
    "status_codes": [403],
    "cookies": ["ak_bmsc", "bm_sz"],
    "bypass_payloads": ["X-Forwarded-For: 127.0.0.1", "True-Client-IP: 127.0.0.1"]
  },
  "AWS_WAF": {
    "headers": ["x-amzn-requestid", "x-amz-cf-id", "x-amz-cf-pop"],
    "body_patterns": ["AWS WAF", "Request blocked"],
    "status_codes": [403],
    "cookies": [],
    "bypass_payloads": ["X-Forwarded-For: 127.0.0.1", "X-Real-IP: 127.0.0.1"]
  },
  "F5_BIG-IP": {
    "headers": ["x-cnection", "x-wa-info"],
    "body_patterns": ["The requested URL was rejected", "F5 Networks", "BIG-IP"],
    "status_codes": [403, 501],
    "cookies": ["BIGipServer", "TS01"],
    "bypass_payloads": ["X-Forwarded-For: 127.0.0.1", "X-Originating-IP: 127.0.0.1"]
  },
  "ModSecurity": {
    "headers": ["x-mod-security-message"],
    "body_patterns": ["ModSecurity", "Not Acceptable!", "406 Not Acceptable", "This error was generated by Mod_Security"],
    "status_codes": [403, 406, 501],
    "cookies": [],
    "bypass_payloads": ["/*!50000select*/", "sElEcT", "UNION/**/SELECT", "%0aUNION", "UNI%00ON"]
  },
  "Imperva_Incapsula": {
    "headers": ["x-iinfo", "x-cdn"],
    "body_patterns": ["Incapsula incident ID", "_Incapsula_Resource", "Request unsuccessful"],
    "status_codes": [403],
    "cookies": ["incap_ses", "visid_incap"],
    "bypass_payloads": ["X-Forwarded-For: 127.0.0.1", "X-Originating-IP: 127.0.0.1"]
  },
  "Sucuri": {
    "headers": ["x-sucuri-id", "x-sucuri-cache"],
    "body_patterns": ["Sucuri WebSite Firewall", "Access Denied - Sucuri Website Firewall"],
    "status_codes": [403],
    "cookies": [],
    "bypass_payloads": ["X-Forwarded-For: 127.0.0.1"]
  },
  "Wordfence": {
    "headers": [],
    "body_patterns": ["Generated by Wordfence", "Wordfence", "Your access to this site has been limited"],
    "status_codes": [403],
    "cookies": ["wfvt_"],
    "bypass_payloads": ["X-Forwarded-For: 127.0.0.1", "User-Agent: Googlebot/2.1"]
  },
  "Barracuda": {
    "headers": ["x-barracuda-connect"],
    "body_patterns": ["Barracuda Web Application Firewall", "barra_counter_session"],
    "status_codes": [400, 403],
    "cookies": ["barra_counter_session"],
    "bypass_payloads": ["X-Forwarded-For: 127.0.0.1"]
  },
  "Fortinet": {
    "headers": ["x-waf-event-info"],
    "body_patterns": ["FortiGate", "FortiWeb", "Application Firewall"],
    "status_codes": [403],
    "cookies": [],
    "bypass_payloads": ["X-Forwarded-For: 127.0.0.1", "X-Real-IP: 127.0.0.1"]
  },
  "Nginx_WAF": {
    "headers": ["x-nginx-cache"],
    "body_patterns": ["nginx", "400 Bad Request", "403 Forbidden"],
    "status_codes": [400, 403],
    "cookies": [],
    "bypass_payloads": ["%0d%0aContent-Length:%200%0d%0a", "X-Forwarded-For: 127.0.0.1"]
  },
  "Wallarm": {
    "headers": ["x-wallarm-node"],
    "body_patterns": ["wallarm", "Wallarm"],
    "status_codes": [403],
    "cookies": [],
    "bypass_payloads": ["X-Forwarded-For: 127.0.0.1"]
  }
}
