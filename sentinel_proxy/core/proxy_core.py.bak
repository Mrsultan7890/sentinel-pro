"""
Proxy Core — Pure Python HTTP/HTTPS proxy engine
=================================================
No mitmproxy dependency. Works on Python 3.13+.
HTTP: full intercept + callback
HTTPS: transparent tunnel (CONNECT method)
"""

import socket
import threading
import logging
import time
from datetime import datetime

logger = logging.getLogger(__name__)


class ProxyCore:
    """
    Pure Python proxy — runs in background thread.
    Callbacks: on_request, on_response
    """

    def __init__(self, host='127.0.0.1', port=8082):
        self.host       = host
        self.port       = port
        self._thread    = None
        self._running   = False
        self._server    = None
        self.intercept  = False
        self.mr_rules   = []

        from sentinel_proxy.core.interceptor import Interceptor
        from sentinel_proxy.core.websocket_handler import WebSocketHandler
        self.interceptor = Interceptor()
        self.ws_handler  = WebSocketHandler()

        self.on_request   = None
        self.on_response  = None
        self.on_websocket = None

    # ── Start / Stop ──────────────────────────────────────────────────────────

    def start(self) -> bool:
        # Port availability check
        import socket as _sock
        try:
            s = _sock.socket(_sock.AF_INET, _sock.SOCK_STREAM)
            s.setsockopt(_sock.SOL_SOCKET, _sock.SO_REUSEADDR, 1)
            s.bind((self.host, self.port))
            s.close()
        except OSError:
            logger.error(f'Port {self.port} already in use')
            return False

        self._running = True
        self._thread  = threading.Thread(
            target=self._run_proxy, daemon=True, name='sentinel-proxy'
        )
        self._thread.start()
        time.sleep(0.5)
        if not self._thread.is_alive():
            self._running = False
            return False
        logger.info(f'[ProxyCore] Started on {self.host}:{self.port}')
        return True

    def stop(self):
        self._running = False
        try:
            self.interceptor.forward_all()
        except Exception:
            pass
        if self._server:
            try:
                self._server.close()
            except Exception:
                pass
        logger.info('[ProxyCore] Stopped')

    def is_running(self) -> bool:
        return self._running and self._thread and self._thread.is_alive()

    # ── Intercept Control ─────────────────────────────────────────────────────

    def intercept_forward(self):
        self.interceptor.forward()

    def intercept_drop(self):
        self.interceptor.drop()

    def intercept_forward_entry(self, entry):
        self.interceptor.forward(entry)

    def intercept_drop_entry(self, entry):
        self.interceptor.drop(entry)

    def intercept_edit_forward(self, entry, headers, body):
        self.interceptor.update_flow(entry, headers, body)
        self.interceptor.forward(entry)

    def get_intercepted(self):
        return self.interceptor.get_pending()

    def pending_count(self):
        return self.interceptor.pending_count()

    # ── Main proxy loop ───────────────────────────────────────────────────────

    def _run_proxy(self):
        try:
            self._server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            self._server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            self._server.bind((self.host, self.port))
            self._server.listen(256)
            self._server.settimeout(1.0)
            logger.info(f'[ProxyCore] Listening on {self.host}:{self.port}')

            while self._running:
                try:
                    client, addr = self._server.accept()
                    t = threading.Thread(
                        target=self._handle_client,
                        args=(client,),
                        daemon=True,
                        name='sp-client'
                    )
                    t.start()
                except socket.timeout:
                    continue
                except Exception:
                    if self._running:
                        continue
                    break
        except Exception as e:
            logger.error(f'[ProxyCore] Server error: {e}')
            self._running = False
        finally:
            if self._server:
                try:
                    self._server.close()
                except Exception:
                    pass

    # ── Client handler ────────────────────────────────────────────────────────

    def _handle_client(self, client_sock):
        try:
            client_sock.settimeout(15)
            data = client_sock.recv(65536)
            if not data:
                client_sock.close()
                return

            first_line = data.split(b'\n')[0].decode('utf-8', errors='replace').strip()
            parts = first_line.split(' ')
            if len(parts) < 2:
                client_sock.close()
                return

            method = parts[0].upper()

            if method == 'CONNECT':
                self._handle_https(client_sock, parts[1])
            else:
                self._handle_http(client_sock, data, method)
        except Exception as e:
            logger.debug(f'[ProxyCore] client error: {e}')
            try:
                client_sock.close()
            except Exception:
                pass

    def _handle_https(self, client_sock, host_port):
        """HTTPS CONNECT tunnel — transparent passthrough."""
        try:
            if ':' in host_port:
                host, port = host_port.rsplit(':', 1)
                port = int(port)
            else:
                host, port = host_port, 443

            remote = socket.create_connection((host, port), timeout=10)
            client_sock.send(b'HTTP/1.1 200 Connection Established\r\n\r\n')

            # Fire on_request callback for CONNECT
            if self.on_request:
                flow = {
                    'id':        str(id(client_sock)),
                    'timestamp': datetime.now().isoformat(),
                    'method':    'CONNECT',
                    'url':       f'https://{host}:{port}',
                    'host':      host,
                    'path':      '/',
                    'headers':   {},
                    'body':      '',
                    'params':    {},
                }
                threading.Thread(
                    target=self.on_request, args=(flow,),
                    daemon=True, name='sp-req'
                ).start()

            def _forward(src, dst):
                try:
                    while self._running:
                        d = src.recv(65536)
                        if not d:
                            break
                        dst.send(d)
                except Exception:
                    pass
                finally:
                    try: src.close()
                    except: pass
                    try: dst.close()
                    except: pass

            t = threading.Thread(target=_forward, args=(remote, client_sock), daemon=True)
            t.start()
            _forward(client_sock, remote)

        except Exception as e:
            logger.debug(f'[ProxyCore] HTTPS tunnel error: {e}')
            try:
                client_sock.send(b'HTTP/1.1 502 Bad Gateway\r\n\r\n')
                client_sock.close()
            except Exception:
                pass

    def _handle_http(self, client_sock, data, method):
        """HTTP proxy — full intercept with callbacks."""
        try:
            # Parse headers
            headers = {}
            host    = ''
            port    = 80
            path    = '/'
            lines   = data.split(b'\r\n')
            first   = lines[0].decode('utf-8', errors='replace')

            # Extract path from request line
            parts = first.split(' ')
            url   = parts[1] if len(parts) > 1 else '/'

            for line in lines[1:]:
                if not line:
                    break
                if b':' in line:
                    k, _, v = line.partition(b':')
                    k = k.decode('utf-8', errors='replace').strip()
                    v = v.decode('utf-8', errors='replace').strip()
                    headers[k] = v
                    if k.lower() == 'host':
                        if ':' in v:
                            host, p = v.rsplit(':', 1)
                            port = int(p)
                        else:
                            host = v

            if not host:
                client_sock.close()
                return

            # Extract body
            body = b''
            if b'\r\n\r\n' in data:
                body = data.split(b'\r\n\r\n', 1)[1]

            # Build path
            if url.startswith('http://'):
                from urllib.parse import urlparse
                parsed = urlparse(url)
                path   = parsed.path or '/'
                if parsed.query:
                    path += '?' + parsed.query
            else:
                path = url

            # Build params from query string
            params = {}
            if '?' in path:
                from urllib.parse import parse_qs
                qs = path.split('?', 1)[1]
                params = {k: v[0] for k, v in parse_qs(qs).items()}

            flow_id = str(id(client_sock))
            t_start = time.time()

            flow = {
                'id':        flow_id,
                'timestamp': datetime.now().isoformat(),
                'method':    method,
                'url':       f'http://{host}{path}',
                'host':      host,
                'path':      path,
                'headers':   headers,
                'body':      body.decode('utf-8', errors='replace')[:5000],
                'params':    params,
            }

            # Apply Match & Replace
            if self.mr_rules:
                try:
                    data = self._apply_mr(data, headers, body, 'request')
                except Exception:
                    pass

            # Intercept hold
            if self.intercept:
                try:
                    should_forward = self.interceptor.hold(flow)
                    if not should_forward:
                        client_sock.close()
                        return
                except Exception:
                    pass

            # Fire on_request
            if self.on_request:
                threading.Thread(
                    target=self.on_request, args=(flow,),
                    daemon=True, name='sp-req'
                ).start()

            # Forward to remote
            remote = socket.create_connection((host, port), timeout=10)
            remote.send(data)

            # Read response
            resp_data = b''
            remote.settimeout(10)
            try:
                while True:
                    chunk = remote.recv(65536)
                    if not chunk:
                        break
                    resp_data += chunk
                    client_sock.send(chunk)
            except socket.timeout:
                pass
            except Exception:
                pass

            remote.close()
            client_sock.close()

            # Parse response for callback
            if self.on_response and resp_data:
                resp_time = round((time.time() - t_start) * 1000, 1)
                resp_flow = self._parse_response(flow, resp_data, resp_time)
                threading.Thread(
                    target=self.on_response, args=(resp_flow,),
                    daemon=True, name='sp-resp'
                ).start()

        except Exception as e:
            logger.debug(f'[ProxyCore] HTTP error: {e}')
            try:
                client_sock.close()
            except Exception:
                pass

    def _parse_response(self, req_flow: dict, resp_data: bytes, resp_time: float) -> dict:
        """Parse raw HTTP response bytes into flow dict."""
        flow = dict(req_flow)
        flow['response_time'] = resp_time
        try:
            if b'\r\n\r\n' in resp_data:
                header_part, body_part = resp_data.split(b'\r\n\r\n', 1)
            else:
                header_part = resp_data
                body_part   = b''

            lines = header_part.split(b'\r\n')
            status_line = lines[0].decode('utf-8', errors='replace')
            parts = status_line.split(' ', 2)
            flow['status_code'] = int(parts[1]) if len(parts) > 1 else 0

            resp_headers = {}
            for line in lines[1:]:
                if b':' in line:
                    k, _, v = line.partition(b':')
                    resp_headers[k.decode('utf-8', errors='replace').strip()] = \
                        v.decode('utf-8', errors='replace').strip()

            flow['resp_headers']  = resp_headers
            flow['resp_body']     = body_part.decode('utf-8', errors='replace')[:10000]
            flow['resp_length']   = len(resp_data)
            flow['content_type']  = resp_headers.get('Content-Type',
                                    resp_headers.get('content-type', ''))
        except Exception:
            flow['status_code'] = 0
            flow['resp_body']   = ''
            flow['resp_length'] = len(resp_data)
            flow['resp_headers'] = {}
            flow['content_type'] = ''
        return flow

    def _apply_mr(self, data: bytes, headers: dict, body: bytes, stage: str) -> bytes:
        """Apply Match & Replace rules to raw request data."""
        import re as _re
        text = data.decode('utf-8', errors='replace')
        for rule in self.mr_rules:
            if not rule.get('enabled'):
                continue
            match   = rule.get('match', '')
            replace = rule.get('replace', '')
            mtype   = rule.get('rule_type', 'Literal')
            target  = rule.get('target', '')
            if target not in ('Request Header', 'Request Body', 'URL', 'Any'):
                continue
            try:
                if mtype == 'Regex':
                    text = _re.sub(match, replace, text)
                else:
                    text = text.replace(match, replace)
            except Exception:
                pass
        return text.encode('utf-8', errors='replace')
