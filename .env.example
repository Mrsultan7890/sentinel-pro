# The Sentinel Pro - Environment Configuration
# Copy this file to .env and configure your settings

# Rate Limiting
OSINT_RATE_LIMIT=10
OSINT_RATE_PERIOD=60

# Request Timeouts (seconds)
OSINT_TIMEOUT=10
OSINT_LONG_TIMEOUT=30

# Stealth Configuration
OSINT_MIN_DELAY=2.0
OSINT_MAX_DELAY=5.0

# Tor Configuration (if using Tor)
TOR_PROXY=socks5h://127.0.0.1:9050
TOR_CONTROL_PORT=9051
TOR_PASSWORD=

# Logging
OSINT_LOG_LEVEL=INFO

# Legal Compliance
OSINT_JURISDICTION=international

# Security
OSINT_SSL_VERIFY=true
OSINT_MAX_RETRIES=3

# Telegram Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Breach APIs
HIBP_API_KEY=
DEHASHED_EMAIL=
DEHASHED_API_KEY=

# Phone OSINT APIs
NUMVERIFY_API_KEY=          # https://numverify.com — free 100 req/month
ABSTRACTAPI_PHONE_KEY=      # https://www.abstractapi.com/phone-validation-api — free 250 req/month

# ML Engine Configuration
ML_CONFIDENCE_THRESHOLD=0.50     # Entity matching minimum confidence (0.0-1.0)
ML_CLUSTER_EPS=0.35              # DBSCAN epsilon — lower = stricter clustering
ML_CLUSTER_MIN_SAMPLES=2         # Minimum usernames to form a cluster
ML_NLP_MAX_TEXT_LENGTH=5000      # Max chars per text for NLP analysis
ML_TIMELINE_MIN_POSTS=3          # Minimum posts for timeline analysis
ML_FINGERPRINT_MIN_WORDS=10      # Minimum words for writing fingerprint

# API Keys (if needed for future integrations)
# SHODAN_API_KEY=your_key_here
# VIRUSTOTAL_API_KEY=your_key_here
# GITHUB_TOKEN=ghp_your_token_here
# SERPAPI_KEY=your_key_here
# SECURITYTRAILS_API_KEY=your_key_here
# NVD_API_KEY=your_key_here
# HIBP_API_KEY=your_key_here          # https://haveibeenpwned.com/API/Key
# DEHASHED_EMAIL=your@email.com       # https://dehashed.com
# DEHASHED_API_KEY=your_key_here
# SHODAN_API_KEY=your_key_here
# VIRUSTOTAL_API_KEY=your_key_here
# GITHUB_TOKEN=ghp_your_token_here
# SERPAPI_KEY=your_key_here
# SECURITYTRAILS_API_KEY=your_key_here
# NVD_API_KEY=your_key_here
